#!/bin/bash
# Runs inside the image after the packages are installed.
set -euo pipefail
# sshd starts only from sandbox-seed.service, once the pinned host key is in place; the stock
# host keys are removed so none can ever be presented.
systemctl disable ssh.socket ssh.service 2>/dev/null || true
systemctl mask ssh.socket
rm -f /etc/ssh/ssh_host_*
systemctl enable sandbox-seed.path
# The in-VM sandbox (staged by build.sh) is the command the host binary proxies to.
ln -sf /usr/lib/sandbox/bin/sandbox /usr/bin/sandbox
# The operator state the host pushes before each command (design 5.1.4) lands in
# /var/lib/sandbox/operator; the in-VM CLI reads ~/.sandbox, as v2 did, so root's points there.
install -d -m 0711 /var/lib/sandbox # traversable, so the sync user reaches its workspaces
install -d -m 0700 /var/lib/sandbox/operator
ln -sfn /var/lib/sandbox/operator /root/.sandbox
# The sync agent runs as its own unprivileged user (design 5.6.2 rule 5), one workspace copy per
# repository under /var/lib/sandbox/workspaces, which only that user's group can enter.
useradd --system --user-group --home-dir /var/lib/sandbox/workspaces --no-create-home --shell /usr/sbin/nologin sandbox-sync
install -d -o root -g sandbox-sync -m 0750 /var/lib/sandbox/workspaces
# Ubuntu's arm64 kernel is a gzip-compressed Image, which systemd-stub (systemd 255) cannot load
# from a unified kernel image ("Bad kernel image"); store it uncompressed before the UKI is built.
for k in /boot/vmlinuz-* /usr/lib/modules/*/vmlinuz; do
  [[ -f "${k}" && ! -L "${k}" ]] || continue
  if [[ "$(od -An -tx1 -N2 "${k}" | tr -d ' ')" == "1f8b" ]]; then
    zcat "${k}" > "${k}.raw" && mv -f "${k}.raw" "${k}"
  fi
done
# containerd (from build.sh's runtime tree) drives the Kata microVMs; buildkit starts on demand.
systemctl enable containerd.service
# sandboxd supervises the sessions; members of the sandbox group (the policy CLI's user) may use
# its socket besides root.
groupadd --system sandbox
systemctl enable sandboxd.service
# Each session's gateway (resolver, connection check, broker, Envoy) runs as its own unprivileged
# id, 70000 plus its uplink slot, with no passwd entry (design 5.8.2; cmd/sandboxd GatewayIDBase).
install -d -m 0711 /var/lib/sandbox/sessions # traversable to each session's gateway directory
# Build-time leftovers that differ between otherwise identical builds.
rm -f /var/cache/ldconfig/aux-cache /var/log/alternatives.log
